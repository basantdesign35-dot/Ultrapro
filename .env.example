# ---------- Public (browser) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ultra-pro-bag-design.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://ultra-pro-bag-design-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ultra-pro-bag-design
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xkjorvdp
# Country code used when a client types a 10-digit number (India = 91)
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
# Optional: company WhatsApp number (digits only, with country code) shown on the
# success page so clients can send their attachment package. Leave empty to hide.
NEXT_PUBLIC_COMPANY_WHATSAPP=

# ---------- Server only (never prefix with NEXT_PUBLIC_) ----------
FIREBASE_ADMIN_PROJECT_ID=ultra-pro-bag-design
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the \n escapes when pasting into Vercel / .env
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://ultra-pro-bag-design-default-rtdb.firebaseio.com
